{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/hvac",
      "destination": "/hvac/",
      "permanent": true
    },
    {
      "source": "/restoration",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/restoration/",
      "destination": "/",
      "permanent": false
    }
  ]
}
